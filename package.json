{
  "name": "blrhikes-2",
  "private": true,
  "scripts": {
    "dev:cms": "pnpm --filter cms dev",
    "dev:web": "pnpm --filter @blrhikes/web dev",
    "build:cms": "pnpm --filter cms build",
    "build:web": "pnpm --filter @blrhikes/web build",
    "migrate": "pnpm --filter cms migrate",
    "migrate:create": "pnpm --filter cms migrate:create",
    "pull": "pnpm --filter @blrhikes/scripts seed:sections -- --refresh",
    "p": "pnpm run pull",
    "seed": "pnpm --filter @blrhikes/scripts seed",
    "seed:refresh": "pnpm --filter @blrhikes/scripts seed -- --refresh",
    "seed:gpx": "pnpm --filter @blrhikes/scripts seed:gpx",
    "sections": "pnpm --filter @blrhikes/scripts seed:sections",
    "sections:write": "pnpm --filter @blrhikes/scripts seed:sections -- --commit",
    "cf:whoami": "set -a && . ./.env && set +a && curl -sS -H \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\" https://api.cloudflare.com/client/v4/user/tokens/verify | jq",
    "cf:workers": "set -a && . ./.env && set +a && curl -sS -H \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\" \"https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/scripts\" | jq '.result | sort_by(.modified_on) | reverse | .[] | {name: .id, modified_on}'",
    "cf:workers:raw": "set -a && . ./.env && set +a && curl -sS -H \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\" \"https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/scripts\" | jq"
  },
  "engines": {
    "node": ">=22"
  }
}
